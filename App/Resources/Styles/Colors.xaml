<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Palette de l'application (thème sombre « Juniro »). Les mêmes couleurs existent en C# dans
  Services/Palette.cs pour les éléments calculés (couleur d'un verdict, d'un résultat, d'une zone).
  Changer une couleur : la modifier ICI et dans Palette.cs.

  Règles : un seul accent (vert citron) pour les actions et la valeur ; bleu = domicile,
  orange = extérieur ; vert / rouge = gagné / perdu.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Fonds -->
    <Color x:Key="Bg">#0A0E17</Color>
    <Color x:Key="Surface">#0F1522</Color>
    <Color x:Key="Card">#141C2B</Color>
    <Color x:Key="CardAlt">#1A2436</Color>
    <Color x:Key="Line">#243049</Color>
    <Color x:Key="LineSoft">#1E2940</Color>
    <Color x:Key="SegmentOn">#243049</Color>

    <!-- Textes -->
    <Color x:Key="Text">#EEF2F8</Color>
    <Color x:Key="TextSoft">#C9D2E1</Color>
    <Color x:Key="TextMuted">#9AA6BC</Color>
    <Color x:Key="TextDim">#7D8AA2</Color>

    <!-- Accent -->
    <Color x:Key="Accent">#C8F04A</Color>
    <Color x:Key="AccentDark">#8FB02A</Color>
    <Color x:Key="AccentSoft">#2A352F</Color>
    <Color x:Key="OnAccent">#0A0E17</Color>

    <!-- États -->
    <Color x:Key="Win">#3DDC97</Color>
    <Color x:Key="WinSoft">#1A373A</Color>
    <Color x:Key="Lose">#FF6B6B</Color>
    <Color x:Key="LoseSoft">#352734</Color>
    <Color x:Key="Even">#FFC24A</Color>

    <!-- Domicile / nul / extérieur -->
    <Color x:Key="HomeColor">#5B9DFF</Color>
    <Color x:Key="HomeSoft">#1C2B47</Color>
    <Color x:Key="DrawColor">#8C97AB</Color>
    <Color x:Key="AwayColor">#FF9F43</Color>
    <Color x:Key="AwaySoft">#36291F</Color>

</ResourceDictionary>
