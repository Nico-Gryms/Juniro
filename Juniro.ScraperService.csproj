<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Les scripts de deploiement restent visibles dans Visual Studio mais ne partent
       jamais dans la sortie de build ni dans le paquet publie. -->
  <ItemGroup>
    <Content Remove="Deploy\**" />
    <None Include="Deploy\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Le moteur Python est installe a part (Deploy\install-analytics.ps1, dans C:\Juniro\analytics) :
       ni ses fichiers, ni son environnement virtuel, ni ses modeles n'entrent dans le build. -->
  <ItemGroup>
    <Content Remove="Analytics\**" />
    <Compile Remove="Analytics\**" />
    <None Remove="Analytics\**" />
    <None Include="Analytics\**" Exclude="Analytics\.venv\**;Analytics\models\**;Analytics\**\__pycache__\**"
          CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- L'application mobile MAUI (dossier App) est un projet a part : ses fichiers ne doivent
       pas etre compiles avec le service. Elle se compile avec App\Juniro.App.csproj. -->
  <ItemGroup>
    <Compile Remove="App\**" />
    <Content Remove="App\**" />
    <EmbeddedResource Remove="App\**" />
    <None Remove="App\**" />
  </ItemGroup>

</Project>
